# OpenPLC Runtime — Windows (MSYS2/Cygwin) patch
# Base commit : cb1060d
# Prerequisite: openplc-runtime-macos-cb1060d.patch MUST be applied first.
#
# Patches included  : W1, W2, W4, W5, W6, W8, W10, W12
# No-ops (excluded) : W3 — MSYS2 winpthread uses 2-arg pthread_setname_np,
#                     identical to Linux; the macOS patch's existing
#                     #ifdef __APPLE__ guard is already correct.
# Diagnostic-only (excluded) : W7, W7b, W9, W11 — instrumentation only,
#                              must not ship in production.
#
# CI proof: run 29074623406

diff --git a/core/src/plc_app/plc_state_manager.cpp b/core/src/plc_app/plc_state_manager.cpp
index dc341a7..e2a1f3b 100644
--- a/core/src/plc_app/plc_state_manager.cpp
+++ b/core/src/plc_app/plc_state_manager.cpp
@@ -110,9 +110,9 @@ static void init_done_cond(void)
 {
     pthread_condattr_t cattr;
     pthread_condattr_init(&cattr);
-#ifndef __APPLE__
+#if !defined(__APPLE__) && !defined(__CYGWIN__) && !defined(__MSYS__)
     pthread_condattr_setclock(&cattr, CLOCK_MONOTONIC);
-#endif
+#endif  /* !__APPLE__ && !__CYGWIN__ && !__MSYS__ */
     pthread_cond_init(&done_cond, &cattr);
     pthread_condattr_destroy(&cattr);
 }
@@ -340,9 +340,9 @@ static void *plc_task_thread(void *arg)
                 if (cnt) image_tables_threaded_copy_out(off, cnt);
             }

-#ifdef __APPLE__
-            /* macOS: SCHED_FIFO unavailable; task bodies often overrun the
+#if defined(__APPLE__) || defined(__CYGWIN__) || defined(__MSYS__)
+            /* macOS/MSYS2/Cygwin: SCHED_FIFO unavailable; task bodies often overrun the
              * 20ms tick, meaning the dispatcher's g_tasks_running==0 drain
              * window never opens.  Drain the debug-write journal here — inside
              * the task body, after copy-out — so debugger forces and writes land
@@ -351,7 +351,7 @@ static void *plc_task_thread(void *arg)
              * not required: GlobalVar<T> accesses use per-variable mutexes;
              * the drain touches only program-local IECVar<T> objects that the
              * scan body just finished using. */
             debug_write_journal_drain();
-#endif
+#endif  /* __APPLE__ || __CYGWIN__ || __MSYS__ */
         }
         catch (const std::exception &e)
         {
@@ -774,10 +774,11 @@ void *plc_cycle_thread(void *arg)
     timespec next_tick;
-#ifdef __APPLE__
-    /* On macOS, pthread_cond_timedwait uses CLOCK_REALTIME (the condvar was
-     * initialized without pthread_condattr_setclock, which macOS doesn't
-     * support for CLOCK_MONOTONIC).  Use CLOCK_REALTIME here to match. */
+#if defined(__APPLE__) || defined(__CYGWIN__) || defined(__MSYS__)
+    /* macOS/MSYS2/Cygwin: pthread_cond_timedwait uses CLOCK_REALTIME (the
+     * condvar was initialized without pthread_condattr_setclock, which macOS
+     * doesn't support for CLOCK_MONOTONIC, and MSYS2/Cygwin winpthread uses
+     * CLOCK_REALTIME by default).  Use CLOCK_REALTIME here to match. */
     clock_gettime(CLOCK_REALTIME, &next_tick);
 #else
     clock_gettime(CLOCK_MONOTONIC, &next_tick);
diff --git a/scripts/compile.sh b/scripts/compile.sh
index 7fdb34b..a3c9e5f 100755
--- a/scripts/compile.sh
+++ b/scripts/compile.sh
@@ -88,14 +88,18 @@ check_required_files
 #   Pi 4 8 GB (nproc=4): cpu=3, mem=8 → -j3
 #   1 GB / 1 core VM:    cpu=1, mem=1 → -j1
 #   Workstation 8c/16GB: cpu=7, mem=16 → -j7
 CPU_JOBS=$(nproc 2>/dev/null || sysctl -n hw.logicalcpu 2>/dev/null || echo 4)
 [ "$CPU_JOBS" -gt 1 ] && CPU_JOBS=$((CPU_JOBS - 1))
-# /proc/meminfo is Linux-only; on macOS use sysctl
+# /proc/meminfo is Linux-only; fall back by platform
 if [ -f /proc/meminfo ]; then
     MEM_KB=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
-else
-    MEM_KB=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 4294967296) / 1024 ))
+elif sysctl -n hw.memsize >/dev/null 2>&1; then
+    MEM_KB=$(( $(sysctl -n hw.memsize) / 1024 ))
+elif command -v wmic >/dev/null 2>&1; then
+    MEM_KB=$(wmic OS get TotalVisibleMemorySize /value 2>/dev/null | grep = | cut -d= -f2 | tr -d '\r\n' || echo 4194304)
+else
+    MEM_KB=4194304
 fi
 MEM_MB=$((MEM_KB / 1024))
 MEM_JOBS=$(( (MEM_MB + 512) / 1024 ))
diff --git a/scripts/compile-clean.sh b/scripts/compile-clean.sh
index d0d96c9..b1e2c37 100755
--- a/scripts/compile-clean.sh
+++ b/scripts/compile-clean.sh
@@ -17,7 +17,8 @@ fi
 # Remove old libplc_* files to ensure only one exists
 rm -f "$BUILD_DIR"/libplc_*"$LIB_EXT"

-TIMESTAMP=$(date +%s%N)
+# %N (nanoseconds) is GNU date; MSYS2 may not support it
+TIMESTAMP=$(date +%s%N 2>/dev/null || echo "$(date +%s)$$")
 UNIQUE_LIBPLC="libplc_${TIMESTAMP}${LIB_EXT}"

 # Move resulting shared library to unique name
diff --git a/scripts/Makefile.strucpp b/scripts/Makefile.strucpp
index 9b6cfe1..b3a2e6f 100644
--- a/scripts/Makefile.strucpp
+++ b/scripts/Makefile.strucpp
@@ -104,7 +104,7 @@ all: $(LIBPLC)
 $(LIBPLC): $(GEN_OBJ) $(SHIM_OBJ) $(EXTRA_OBJS) | $(BUILD_DIR)
 ifeq ($(IS_MACOS),1)

diff --git a/webserver/app.py b/webserver/app.py
index 6d4cb8b..f1a9c2e 100644
--- a/webserver/app.py
+++ b/webserver/app.py
@@ -108,8 +108,12 @@ def upload_program():
     if not zip_file:
         return jsonify({'error': 'No file provided'}), 400

-    safe, valid_files = analyze_zip(zip_file)
+    # Read the Werkzeug FileStorage into an in-memory buffer before analysis
+    # and extraction.  Cygwin Python's zipfile module has a seek bug on the
+    # raw Werkzeug stream; BytesIO avoids it entirely.
+    import io as _io
+    _zip_bytes = _io.BytesIO(zip_file.read())
+    safe, valid_files = analyze_zip(_zip_bytes)

     if not safe:
         return jsonify({'error': 'Unsafe zip file detected'}), 400
@@ -119,7 +123,7 @@ def upload_program():
     if not os.path.exists(UPLOAD_FOLDER):
         os.makedirs(UPLOAD_FOLDER)

-    safe_extract(zip_file, UPLOAD_FOLDER, valid_files)
+    safe_extract(_zip_bytes, UPLOAD_FOLDER, valid_files)

     return jsonify({'success': True}), 200

diff --git a/webserver/plcapp_management.py b/webserver/plcapp_management.py
index a1b2c3d..d4e5f6a 100644
--- a/webserver/plcapp_management.py
+++ b/webserver/plcapp_management.py
@@ -1,6 +1,7 @@
 import os
 import sys
 import zipfile
+import io
 import subprocess
 import platform
 import tempfile
@@ -25,16 +26,60 @@ def analyze_zip(zip_source):
     """
     Validate a zip archive for path-traversal attacks and return
     (is_safe: bool, valid_files: list[str]).
-    zip_source may be a file path, file-like object, or BytesIO.
+    zip_source may be a file path, file-like object, or BytesIO.
+    BytesIO is rewound before use so the caller need not track position.
     """
+    if isinstance(zip_source, io.BytesIO):
+        zip_source.seek(0)
+
     if not zipfile.is_zipfile(zip_source):
         return False, []

+    if isinstance(zip_source, io.BytesIO):
+        zip_source.seek(0)
+
     valid_files = []
     with zipfile.ZipFile(zip_source) as zf:
         for name in zf.namelist():
             if '..' in name or name.startswith('/'):
                 return False, []
             valid_files.append(name)
     return True, valid_files

+
+def _is_cygwin_or_msys():
+    """Return True when running under Cygwin or MSYS2."""
+    s = platform.system().lower()
+    return 'cygwin' in s or 'msys' in s or os.environ.get('MSYSTEM') is not None
+
+
 def safe_extract(zip_source, dest_dir, valid_files):
     """
-    Extract only the pre-validated file list from zip_source into dest_dir.
-    zip_source may be a file path, file-like object, or BytesIO.
+    Extract only the pre-validated file list from zip_source into dest_dir.
+
+    On MSYS2/Cygwin the Python zipfile module has a seek bug on certain stream
+    types; delegate to the system `unzip` binary instead.  On all other
+    platforms use Python zipfile directly.
+
+    zip_source may be a file path, file-like object, or BytesIO.
     """
-    with zipfile.ZipFile(zip_source) as zf:
-        for name in valid_files:
-            zf.extract(name, dest_dir)
+    if _is_cygwin_or_msys():
+        # Materialise BytesIO to a temp file so `unzip` can read it.
+        if isinstance(zip_source, io.BytesIO):
+            zip_source.seek(0)
+            tmp = tempfile.NamedTemporaryFile(suffix='.zip', delete=False)
+            try:
+                tmp.write(zip_source.read())
+                tmp.flush()
+                tmp.close()
+                _unzip_with_subprocess(tmp.name, dest_dir, valid_files)
+            finally:
+                try:
+                    os.unlink(tmp.name)
+                except OSError:
+                    pass
+        else:
+            _unzip_with_subprocess(zip_source, dest_dir, valid_files)
+    else:
+        if isinstance(zip_source, io.BytesIO):
+            zip_source.seek(0)
+        with zipfile.ZipFile(zip_source) as zf:
+            for name in valid_files:
+                zf.extract(name, dest_dir)
+
+
+def _unzip_with_subprocess(zip_path, dest_dir, valid_files):
+    """Extract specific files from zip_path into dest_dir via system unzip."""
+    cmd = ['unzip', '-o', '-d', dest_dir, zip_path] + list(valid_files)
+    result = subprocess.run(cmd, capture_output=True, text=True)
+    if result.returncode != 0:
+        raise RuntimeError(
+            'unzip failed (rc={}): {}'.format(result.returncode, result.stderr)
+        )

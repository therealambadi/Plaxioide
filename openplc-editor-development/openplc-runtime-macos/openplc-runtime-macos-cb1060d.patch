diff --git a/scripts/compile.sh b/scripts/compile.sh
index 90609b7..7fdb34b 100755
--- a/scripts/compile.sh
+++ b/scripts/compile.sh
@@ -88,9 +88,14 @@ check_required_files
 #   Pi 4 8 GB (nproc=4): cpu=3, mem=8 → -j3
 #   1 GB / 1 core VM:    cpu=1, mem=1 → -j1
 #   Workstation 8c/16GB: cpu=7, mem=16 → -j7
-CPU_JOBS=$(nproc)
+CPU_JOBS=$(nproc 2>/dev/null || sysctl -n hw.logicalcpu 2>/dev/null || echo 4)
 [ "$CPU_JOBS" -gt 1 ] && CPU_JOBS=$((CPU_JOBS - 1))
-MEM_KB=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
+# /proc/meminfo is Linux-only; on macOS use sysctl
+if [ -f /proc/meminfo ]; then
+    MEM_KB=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
+else
+    MEM_KB=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 4294967296) / 1024 ))
+fi
 MEM_MB=$((MEM_KB / 1024))
 MEM_JOBS=$(( (MEM_MB + 512) / 1024 ))
 [ "$MEM_JOBS" -lt 1 ] && MEM_JOBS=1

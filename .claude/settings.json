{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; d=json.load(sys.stdin); p=d.get('file_path',''); sys.exit(1 if '/src2/' in p else 0)\"",
            "blocking": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -i 'error\\|uncaught\\|typeerror' /tmp/void-console.log 2>/dev/null | tail -5 || true"
          }
        ]
      }
    ]
  }
}

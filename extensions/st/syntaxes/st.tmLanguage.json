{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Structured Text",
	"scopeName": "source.st",
	"fileTypes": ["st", "iec", "iec61131"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#program-block" },
		{ "include": "#function-block" },
		{ "include": "#function-decl" },
		{ "include": "#var-block" },
		{ "include": "#keywords-control" },
		{ "include": "#keywords-storage" },
		{ "include": "#keywords-case" },
		{ "include": "#operators" },
		{ "include": "#literals-time" },
		{ "include": "#literals-numeric" },
		{ "include": "#literals-bool" },
		{ "include": "#standard-fb-types" },
		{ "include": "#standard-functions" },
		{ "include": "#data-types" },
		{ "include": "#fb-instance-call" },
		{ "include": "#fb-output-access" },
		{ "include": "#identifier" }
	],
	"repository": {

		"comments": {
			"patterns": [
				{
					"name": "comment.block.st",
					"begin": "\\(\\*",
					"end": "\\*\\)",
					"beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.st" } },
					"endCaptures": { "0": { "name": "punctuation.definition.comment.end.st" } }
				},
				{
					"name": "comment.line.double-slash.st",
					"match": "//.*$"
				}
			]
		},

		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.st",
					"begin": "\"",
					"end": "\"",
					"patterns": [{ "name": "constant.character.escape.st", "match": "\\\\." }]
				},
				{
					"name": "string.quoted.single.st",
					"begin": "'",
					"end": "'",
					"patterns": [{ "name": "constant.character.escape.st", "match": "\\$." }]
				}
			]
		},

		"program-block": {
			"patterns": [
				{
					"name": "meta.block.program.st",
					"begin": "(?i)\\b(PROGRAM)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"end": "(?i)\\b(END_PROGRAM)\\b",
					"beginCaptures": {
						"1": { "name": "keyword.declaration.program.st" },
						"2": { "name": "entity.name.type.program.st" }
					},
					"endCaptures": {
						"1": { "name": "keyword.declaration.program.st" }
					},
					"patterns": [{ "include": "$self" }]
				}
			]
		},

		"function-block": {
			"patterns": [
				{
					"name": "meta.block.function-block.st",
					"begin": "(?i)\\b(FUNCTION_BLOCK)\\s+([A-Za-z_][A-Za-z0-9_]*)",
					"end": "(?i)\\b(END_FUNCTION_BLOCK)\\b",
					"beginCaptures": {
						"1": { "name": "keyword.declaration.function-block.st" },
						"2": { "name": "entity.name.type.function-block.st" }
					},
					"endCaptures": {
						"1": { "name": "keyword.declaration.function-block.st" }
					},
					"patterns": [{ "include": "$self" }]
				}
			]
		},

		"function-decl": {
			"patterns": [
				{
					"name": "meta.block.function.st",
					"begin": "(?i)\\b(FUNCTION)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)?",
					"end": "(?i)\\b(END_FUNCTION)\\b",
					"beginCaptures": {
						"1": { "name": "keyword.declaration.function.st" },
						"2": { "name": "entity.name.function.st" },
						"3": { "name": "punctuation.separator.colon.st" }
					},
					"endCaptures": {
						"1": { "name": "keyword.declaration.function.st" }
					},
					"patterns": [{ "include": "$self" }]
				}
			]
		},

		"var-block": {
			"patterns": [
				{
					"name": "meta.block.var.st",
					"begin": "(?i)\\b(VAR(?:_INPUT|_OUTPUT|_IN_OUT|_TEMP|_EXTERNAL|_ACCESS|_GLOBAL)?)\\b",
					"end": "(?i)\\b(END_VAR)\\b",
					"beginCaptures": { "1": { "name": "keyword.declaration.var.st" } },
					"endCaptures": { "1": { "name": "keyword.declaration.var.st" } },
					"patterns": [
						{ "include": "#comments" },
						{
							"match": "(?i)\\b(RETAIN|PERSISTENT|CONSTANT|AT)\\b",
							"captures": { "1": { "name": "storage.modifier.st" } }
						},
						{
							"match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?:AT\\s+%[IQM][XBWDL]?[0-9.]+)?\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\[.*?\\])?)",
							"captures": {
								"1": { "name": "variable.other.declaration.st" },
								"2": { "name": "punctuation.separator.colon.st" },
								"3": { "name": "storage.type.st" }
							}
						},
						{ "include": "#literals-time" },
						{ "include": "#literals-numeric" },
						{ "include": "#literals-bool" },
						{ "include": "#data-types" },
						{ "include": "#strings" }
					]
				}
			]
		},

		"keywords-control": {
			"patterns": [
				{
					"name": "keyword.control.st",
					"match": "(?i)\\b(IF|THEN|ELSIF|ELSE|END_IF|CASE|OF|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|RETURN|EXIT|CONTINUE|JMP|LABEL)\\b"
				}
			]
		},

		"keywords-storage": {
			"patterns": [
				{
					"name": "keyword.declaration.st",
					"match": "(?i)\\b(PROGRAM|END_PROGRAM|FUNCTION_BLOCK|END_FUNCTION_BLOCK|FUNCTION|END_FUNCTION|VAR|VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_TEMP|VAR_EXTERNAL|VAR_ACCESS|VAR_GLOBAL|END_VAR|TYPE|END_TYPE|STRUCT|END_STRUCT|ARRAY|RETAIN|PERSISTENT|CONSTANT|AT|SUPER|THIS)\\b"
				}
			]
		},

		"keywords-case": {
			"patterns": [
				{
					"name": "keyword.control.case.st",
					"match": "(?i)\\b(CASE|OF|END_CASE|ELSE)\\b"
				}
			]
		},

		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.logical.st",
					"match": "(?i)\\b(AND|OR|NOT|XOR)\\b"
				},
				{
					"name": "keyword.operator.comparison.st",
					"match": "<>|<=|>=|:=|=>|<|>|="
				},
				{
					"name": "keyword.operator.arithmetic.st",
					"match": "(?i)\\b(MOD)\\b|[+\\-*/]"
				},
				{
					"name": "punctuation.separator.st",
					"match": "[;:,.]"
				},
				{
					"name": "punctuation.brackets.st",
					"match": "[()\\[\\]]"
				}
			]
		},

		"literals-time": {
			"patterns": [
				{
					"name": "constant.numeric.time.st",
					"match": "(?i)\\b(T|TIME|LT|LTIME)#[0-9dhms_]+[0-9]\\b"
				},
				{
					"name": "constant.numeric.date.st",
					"match": "(?i)\\b(DATE|D)#[0-9]{4}-[0-9]{2}-[0-9]{2}\\b"
				},
				{
					"name": "constant.numeric.time-of-day.st",
					"match": "(?i)\\b(TIME_OF_DAY|TOD)#[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?\\b"
				}
			]
		},

		"literals-numeric": {
			"patterns": [
				{
					"name": "constant.numeric.hex.st",
					"match": "(?i)16#[0-9A-Fa-f_]+"
				},
				{
					"name": "constant.numeric.octal.st",
					"match": "(?i)8#[0-7_]+"
				},
				{
					"name": "constant.numeric.binary.st",
					"match": "(?i)2#[01_]+"
				},
				{
					"name": "constant.numeric.float.st",
					"match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
				},
				{
					"name": "constant.numeric.integer.st",
					"match": "\\b[0-9][0-9_]*\\b"
				}
			]
		},

		"literals-bool": {
			"patterns": [
				{
					"name": "constant.language.boolean.st",
					"match": "(?i)\\b(TRUE|FALSE)\\b"
				},
				{
					"name": "constant.language.null.st",
					"match": "(?i)\\bNULL\\b"
				}
			]
		},

		"standard-fb-types": {
			"patterns": [
				{
					"name": "support.class.fb.st",
					"match": "(?i)\\b(TON|TOF|TP|CTU|CTD|CTUD|SR|RS|R_TRIG|F_TRIG|RTRIG|FTRIG|SEMA|RTC|DERIVATIVE|INTEGRAL|PID|RAMP|HYSTERESIS|BLINK)\\b"
				}
			]
		},

		"standard-functions": {
			"patterns": [
				{
					"name": "support.function.standard.st",
					"match": "(?i)\\b(ABS|SQRT|LN|LOG|EXP|SIN|COS|TAN|ASIN|ACOS|ATAN|ATAN2|EXPT|MAX|MIN|LIMIT|MUX|SEL|MOVE|SHL|SHR|ROR|ROL|AND|OR|XOR|NOT|ADD|SUB|MUL|DIV|MOD|CONCAT|DELETE|FIND|INSERT|LEFT|LEN|REPLACE|RIGHT|MID|UPPER|LOWER|TRIM|INT_TO_REAL|REAL_TO_INT|INT_TO_DINT|DINT_TO_INT|BOOL_TO_INT|INT_TO_BOOL|REAL_TO_BOOL|BOOL_TO_REAL|INT_TO_REAL|DINT_TO_REAL|REAL_TO_DINT|TIME_TO_INT|INT_TO_TIME|WORD_TO_INT|INT_TO_WORD|BYTE_TO_INT|INT_TO_BYTE|USINT_TO_INT|INT_TO_USINT|ANY_TO_INT|ANY_TO_REAL|ANY_TO_BOOL|ANY_TO_STRING|SIZEOF|ADDRESSOF|INDEXOF)\\b"
				}
			]
		},

		"data-types": {
			"patterns": [
				{
					"name": "storage.type.primitive.st",
					"match": "(?i)\\b(BOOL|BYTE|WORD|DWORD|LWORD|SINT|USINT|INT|UINT|DINT|UDINT|LINT|ULINT|REAL|LREAL|TIME|LTIME|DATE|TIME_OF_DAY|TOD|DATE_AND_TIME|DT|STRING|WSTRING|CHAR|WCHAR|ANY|ANY_BIT|ANY_INT|ANY_NUM|ANY_REAL|ANY_ELEMENTARY|ANY_DERIVED)\\b"
				}
			]
		},

		"fb-instance-call": {
			"comment": "FB instance calls: TimerName(IN := x, PT := T#5s)",
			"patterns": [
				{
					"name": "meta.function-call.fb.st",
					"match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
					"captures": {
						"1": { "name": "variable.other.fb-instance.st" },
						"2": { "name": "punctuation.brackets.open.st" }
					}
				}
			]
		},

		"fb-output-access": {
			"comment": "FB output member access: TimerName.Q, TimerName.ET",
			"patterns": [
				{
					"match": "([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "variable.other.fb-instance.st" },
						"2": { "name": "punctuation.accessor.dot.st" },
						"3": { "name": "variable.other.member.st" }
					}
				}
			]
		},

		"identifier": {
			"patterns": [
				{
					"name": "variable.other.st",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		}
	}
}
